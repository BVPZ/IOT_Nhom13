# Cấu hình MQTT Broker
MQTT_BROKER_URL=your-mqtt-broker.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# Cấu hình Database & Bảo mật Backend
DATABASE_URL=sqlite:///./iot_system.db
JWT_SECRET_KEY=replace_with_your_secret_key_here
JWT_ALGORITHM=HS256

# Cấu hình Cảnh báo Telegram (Tùy chọn)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
